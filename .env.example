# --- Base ---
NODE_ENV=development
PORT=3000
# Detrás de un proxy reverso (nginx, Caddy, Railway): true o cantidad de saltos. Con el puerto expuesto directo, false.
TRUST_PROXY=false
# URL pública del panel (se usa para cookies y enlaces)
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://bot:bot_local_password@localhost:5433/bot
# Clave de 32 bytes en base64 para cifrar la sesión de WhatsApp. Generar con: openssl rand -base64 32
ENCRYPTION_KEY=
LOG_LEVEL=info

# --- WhatsApp (Baileys) ---
# false = no se conecta a WhatsApp al arrancar (útil en desarrollo y pruebas)
WHATSAPP_ENABLED=true

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TIMEOUT_MS=30000

# --- Tiendanube ---
TIENDANUBE_STORE_ID=
TIENDANUBE_ACCESS_TOKEN=
# Secreto de la app (para verificar webhooks)
TIENDANUBE_APP_SECRET=
TIENDANUBE_USER_AGENT="MaleStyleAI (contacto@ejemplo.com)"
TIENDANUBE_API_VERSION=2025-03
# Cada cuántos minutos se resincroniza el catálogo completo (además de los webhooks)
CATALOG_SYNC_INTERVAL_MINUTES=60
