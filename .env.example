# --- Base ---
NODE_ENV=development
PORT=3000
# Detrás de un proxy reverso (nginx, Caddy, Railway): true o cantidad de saltos. Con el puerto expuesto directo, false.
TRUST_PROXY=false
# URL pública del panel (se usa para cookies y enlaces)
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://bot:bot_local_password@localhost:5433/bot
# Clave de 32 bytes en base64 para cifrar la sesión de WhatsApp. Generar con: openssl rand -base64 32
ENCRYPTION_KEY=
LOG_LEVEL=info

# --- WhatsApp (Baileys) ---
# false = no se conecta a WhatsApp al arrancar (útil en desarrollo y pruebas)
WHATSAPP_ENABLED=true

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TIMEOUT_MS=30000

# Modelo para embeddings del conocimiento (búsqueda semántica)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Biblioteca multimedia ---
# En producción debe ser un volumen persistente (ver docs/RAILWAY.md)
MEDIA_DIR=./data/media
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=16
# Tamaño máximo de un chat exportado (TXT o ZIP)
IMPORT_MAX_MB=200
