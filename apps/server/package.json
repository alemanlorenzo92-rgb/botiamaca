{
  "name": "@bot/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=../../.env src/cli.ts seed"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@hapi/boom": "^10.0.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "adm-zip": "^0.6.1",
    "baileys": "7.0.0-rc14",
    "fastify": "5.12.8",
    "file-type": "^22.3.0",
    "openai": "7.57.0",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/node": "22.14.0",
    "@types/qrcode": "1.5.6",
    "prisma": "6.19.3",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.1.1"
  }
}
