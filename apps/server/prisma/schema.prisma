generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------- Usuarios y acceso ----------

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("roles")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  roleId       String    @map("role_id") @db.Uuid
  role         Role      @relation(fields: [roleId], references: [id])
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  conversations Conversation[]
  messages      Message[]
  assignments   HumanAssignment[]
  followups     Followup[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

// ---------- Clientes y conversaciones ----------

enum BuyerType {
  UNKNOWN
  RETAIL
  WHOLESALE
  EVENT
}

model Contact {
  id               String    @id @default(uuid()) @db.Uuid
  /// JID de WhatsApp al que se responde (puede ser @s.whatsapp.net o @lid)
  waJid            String    @unique @map("wa_jid")
  /// JID alternativo (número o LID) informado por WhatsApp
  waAltJid         String?   @map("wa_alt_jid")
  phone            String?
  name             String?
  pushName         String?   @map("push_name")
  buyerType        BuyerType @default(UNKNOWN) @map("buyer_type")
  interests        String[]
  notes            String?
  /// Resumen persistente que la IA usa como memoria
  memorySummary    String?   @map("memory_summary")
  memoryUpdatedAt  DateTime? @map("memory_updated_at")
  marketingConsent Boolean   @default(false) @map("marketing_consent")
  /// La dueña lo atiende siempre (familia, amigos, proveedores): la IA nunca le responde
  botMuted         Boolean   @default(false) @map("bot_muted")
  consentAt        DateTime? @map("consent_at")
  lastMessageAt    DateTime? @map("last_message_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  conversation Conversation?
  carts        Cart[]
  orders       Order[]
  eventLeads   EventLead[]
  followups    Followup[]

  @@index([waAltJid])
  @@index([phone])
  @@map("contacts")
}

enum ConversationStatus {
  AI_ACTIVE
  HUMAN_REQUESTED
  HUMAN_ACTIVE
  AI_PAUSED
  RESOLVED
}

model Conversation {
  id                 String             @id @default(uuid()) @db.Uuid
  contactId          String             @unique @map("contact_id") @db.Uuid
  contact            Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status             ConversationStatus @default(AI_ACTIVE)
  assignedUserId     String?            @map("assigned_user_id") @db.Uuid
  assignedUser       User?              @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  humanRequestedAt   DateTime?          @map("human_requested_at")
  humanRequestReason String?            @map("human_request_reason")
  unreadCount        Int                @default(0) @map("unread_count")
  lastInboundAt      DateTime?          @map("last_inbound_at")
  lastOutboundAt     DateTime?          @map("last_outbound_at")
  /// Último seguimiento automático enviado (uno por cada vez que la clienta deja de responder)
  autoFollowupAt     DateTime?          @map("auto_followup_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  messages    Message[]
  assignments HumanAssignment[]
  aiRuns      AiRun[]
  carts       Cart[]
  eventLeads  EventLead[]
  followups   Followup[]

  @@index([status, updatedAt])
  @@map("conversations")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAuthor {
  CUSTOMER
  AI
  HUMAN
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  OTHER
}

enum MessageStatus {
  RECEIVED
  PENDING
  SENT
  FAILED
  DISCARDED
}

model Message {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  author         MessageAuthor
  /// ID del mensaje en WhatsApp. Único para evitar duplicados por reintentos.
  externalId     String?          @unique @map("external_id")
  type           MessageType      @default(TEXT)
  text           String?
  mediaMime      String?          @map("media_mime")
  mediaId        String?          @map("media_id") @db.Uuid
  media          MediaAsset?      @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  status         MessageStatus
  sentByUserId   String?          @map("sent_by_user_id") @db.Uuid
  sentByUser     User?            @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)
  /// Para mensajes entrantes: cuándo los procesó la IA (o se decidió no responder)
  aiHandledAt    DateTime?        @map("ai_handled_at")
  error          String?
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([direction, aiHandledAt])
  @@map("messages")
}

enum AssignmentAction {
  REQUESTED
  TAKEN
  ASSIGNED
  RELEASED
  PAUSED
  RESOLVED
}

enum ActorType {
  USER
  AI
  CUSTOMER
  SYSTEM
}

model HumanAssignment {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  action         AssignmentAction
  actorType      ActorType        @map("actor_type")
  userId         String?          @map("user_id") @db.Uuid
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason         String?
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("human_assignments")
}

enum AiRunStatus {
  OK
  ERROR
  SKIPPED
}

model AiRun {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  model          String
  status         AiRunStatus
  inputTokens    Int          @default(0) @map("input_tokens")
  outputTokens   Int          @default(0) @map("output_tokens")
  toolCalls      Json         @default("[]") @map("tool_calls")
  latencyMs      Int          @default(0) @map("latency_ms")
  error          String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([conversationId, createdAt])
  @@map("ai_runs")
}

// ---------- Catálogo ----------

model Category {
  id          String            @id @default(uuid()) @db.Uuid
  externalId  String?           @unique @map("external_id")
  name        String
  description String?
  media       MediaAsset[]
  tutorials   Tutorial[]
  handle      String?
  parentId    String?           @map("parent_external_id")
  visible     Boolean           @default(true)
  syncedAt    DateTime          @default(now()) @map("synced_at")
  products    ProductCategory[]

  @@map("categories")
}

model Product {
  id              String            @id @default(uuid()) @db.Uuid
  externalId      String?           @unique @map("external_id")
  name            String
  description     String?
  /// Características, usos y recomendaciones cargadas por la dueña
  features        String?
  usage           String?
  recommendations String?
  /// [{ "q": "...", "a": "..." }]
  faqs            Json              @default("[]")
  media           MediaAsset[]
  tutorials       Tutorial[]
  handle          String?
  url             String?
  brand           String?
  tags            String[]
  attributes      String[]
  imageUrls       String[]          @map("image_urls")
  published       Boolean           @default(true)
  freeShipping    Boolean           @default(false) @map("free_shipping")
  /// Texto normalizado (minúsculas, sin acentos) para búsqueda
  searchText      String            @default("") @map("search_text")
  sourceUpdatedAt DateTime?         @map("source_updated_at")
  syncedAt        DateTime          @default(now()) @map("synced_at")
  deletedAt       DateTime?         @map("deleted_at")
  categories      ProductCategory[]
  variants        ProductVariant[]

  @@map("products")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id         String         @id @default(uuid()) @db.Uuid
  externalId String?        @unique @map("external_id")
  productId  String         @map("product_id") @db.Uuid
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?
  values     String[]
  weightKg   Decimal?       @map("weight_kg") @db.Decimal(10, 3)
  deletedAt  DateTime?      @map("deleted_at")
  syncedAt   DateTime       @default(now()) @map("synced_at")
  prices     VariantPrice[]
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model PriceList {
  id          String         @id @default(uuid()) @db.Uuid
  /// LIST, PROMO, TRANSFER, WHOLESALE u otras configuradas
  code        String         @unique
  name        String
  source      String
  description String?
  prices      VariantPrice[]

  @@map("price_lists")
}

/// Historial de precios: el vigente es el que tiene valid_to NULL.
model VariantPrice {
  id          String         @id @default(uuid()) @db.Uuid
  variantId   String         @map("variant_id") @db.Uuid
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceListId String         @map("price_list_id") @db.Uuid
  priceList   PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  amount      Decimal        @db.Decimal(12, 2)
  currency    String         @default("ARS")
  validFrom   DateTime       @default(now()) @map("valid_from")
  validTo     DateTime?      @map("valid_to")

  @@index([variantId, priceListId, validTo])
  @@map("variant_prices")
}

model Inventory {
  variantId String         @id @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// false = la tienda no controla stock de esta variante
  managed   Boolean
  quantity  Int?
  syncedAt  DateTime       @default(now()) @map("synced_at")

  @@map("inventory")
}

// ---------- Ventas ----------

enum CartStatus {
  OPEN
  CONVERTED
  ABANDONED
}

model Cart {
  id             String        @id @default(uuid()) @db.Uuid
  contactId      String        @map("contact_id") @db.Uuid
  contact        Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?       @map("conversation_id") @db.Uuid
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status         CartStatus    @default(OPEN)
  wholesale      Boolean       @default(false)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  items          CartItem[]
  order          Order?

  @@index([contactId, status])
  @@map("carts")
}

model CartItem {
  id            String         @id @default(uuid()) @db.Uuid
  cartId        String         @map("cart_id") @db.Uuid
  cart          Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId     String         @map("variant_id") @db.Uuid
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  quantity      Int
  /// Precio vigente al agregar (referencia; se revalida al confirmar)
  unitPrice     Decimal?       @map("unit_price") @db.Decimal(12, 2)
  priceListCode String?        @map("price_list_code")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@unique([cartId, variantId])
  @@map("cart_items")
}

enum OrderStatus {
  PENDING_REVIEW
  CONFIRMED
  CANCELLED
  FULFILLED
}

enum OrderSource {
  BOT
  TIENDANUBE
  MANUAL
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  number        Int         @unique @default(autoincrement())
  contactId     String      @map("contact_id") @db.Uuid
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  cartId        String?     @unique @map("cart_id") @db.Uuid
  cart          Cart?       @relation(fields: [cartId], references: [id], onDelete: SetNull)
  status        OrderStatus @default(PENDING_REVIEW)
  source        OrderSource @default(BOT)
  externalId    String?     @unique @map("external_id")
  wholesale     Boolean     @default(false)
  totalEstimate Decimal?    @map("total_estimate") @db.Decimal(12, 2)
  shippingNotes String?     @map("shipping_notes")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  items         OrderItem[]
  followups     Followup[]

  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @map("order_id") @db.Uuid
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?         @map("variant_id") @db.Uuid
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description String
  quantity    Int
  unitPrice   Decimal?        @map("unit_price") @db.Decimal(12, 2)

  @@map("order_items")
}

// ---------- Eventos (Glitter Bar / Shimmer Walls) ----------

enum EventService {
  GLITTER_BAR
  SHIMMER_WALL
}

enum EventLeadStatus {
  NEW
  QUOTING
  QUOTED
  WON
  LOST
}

model EventLead {
  id                String          @id @default(uuid()) @db.Uuid
  contactId         String          @map("contact_id") @db.Uuid
  contact           Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId    String?         @map("conversation_id") @db.Uuid
  conversation      Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  service           EventService
  status            EventLeadStatus @default(NEW)
  customerName      String?         @map("customer_name")
  eventDate         DateTime?       @map("event_date") @db.Date
  eventDateText     String?         @map("event_date_text")
  location          String?
  eventType         String?         @map("event_type")
  guests            Int?
  startTime         String?         @map("start_time")
  duration          String?
  servicesRequested String?         @map("services_requested")
  measures          String?
  colorStyle        String?         @map("color_style")
  rentalDuration    String?         @map("rental_duration")
  extraInfo         String?         @map("extra_info")
  quoteAmount       Decimal?        @map("quote_amount") @db.Decimal(12, 2)
  quoteNotes        String?         @map("quote_notes")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  followups         Followup[]

  @@index([service, status])
  @@index([eventDate])
  @@map("event_leads")
}

enum FollowupStatus {
  PENDING
  DONE
  CANCELLED
}

model Followup {
  id             String         @id @default(uuid()) @db.Uuid
  contactId      String         @map("contact_id") @db.Uuid
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?        @map("conversation_id") @db.Uuid
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  eventLeadId    String?        @map("event_lead_id") @db.Uuid
  eventLead      EventLead?     @relation(fields: [eventLeadId], references: [id], onDelete: SetNull)
  orderId        String?        @map("order_id") @db.Uuid
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedUserId String?        @map("assigned_user_id") @db.Uuid
  assignedUser   User?          @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  dueAt          DateTime       @map("due_at")
  reason         String
  status         FollowupStatus @default(PENDING)
  createdBy      ActorType      @map("created_by")
  notifiedAt     DateTime?      @map("notified_at")
  completedAt    DateTime?      @map("completed_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([status, dueAt])
  @@map("followups")
}

// ---------- Configuración ----------

/// Datos del negocio editables desde el panel. Un valor ausente = "no configurado".
model BusinessSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("business_settings")
}

model AiSetting {
  id                  Int      @id @default(1)
  /// Interruptor de emergencia: false apaga todas las respuestas automáticas
  enabled             Boolean  @default(true)
  model               String?
  temperature         Float?
  maxOutputTokens     Int?     @map("max_output_tokens")
  personality         String
  instructions        String
  greeting            String?
  handoffMessage      String   @map("handoff_message")
  errorMessage        String   @map("error_message")
  /// Horario de atención de la IA. null = 24 horas.
  businessHours       Json?    @map("business_hours")
  outsideHoursMessage String?  @map("outside_hours_message")
  maxRepliesPerHour   Int      @default(30) @map("max_replies_per_hour")
  dailyTokenBudget    Int?     @map("daily_token_budget")
  debounceSeconds     Int      @default(4) @map("debounce_seconds")
  historyMessages     Int      @default(20) @map("history_messages")
  /// Seguimiento automático si la clienta deja de responder (null = apagado). Una sola vez por silencio, sin precios.
  followupAfterHours  Int?     @default(72) @map("followup_after_hours")
  followupMessage     String   @default("¡Hola! ¿Pudiste ver lo que te pasé? Contame qué producto te interesó y te paso la info 😊") @map("followup_message")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
}

model IntegrationSetting {
  provider   String    @id
  enabled    Boolean   @default(false)
  config     Json      @default("{}")
  status     String    @default("NOT_CONFIGURED")
  lastSyncAt DateTime? @map("last_sync_at")
  lastError  String?   @map("last_error")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("integration_settings")
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  action     String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  data       Json      @default("{}")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------- WhatsApp ----------

/// Estado de autenticación de Baileys, cifrado.
model WaAuthKey {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("wa_auth_keys")
}

model WaState {
  id             Int       @id @default(1)
  status         String    @default("DISCONNECTED")
  meJid          String?   @map("me_jid")
  lastConnected  DateTime? @map("last_connected_at")
  lastDisconnect DateTime? @map("last_disconnect_at")
  lastError      String?   @map("last_error")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("wa_state")
}

model ServiceInfo {
  service     EventService @id
  name        String
  description String       @default("")
  /// Condiciones comerciales (señas, traslados, mínimos...). Vacío = no cargado
  conditions  String       @default("")
  /// [{ "q": "...", "a": "..." }]
  faqs        Json         @default("[]")
  /// Datos extra libres (zonas, duración, medidas disponibles...)
  info        Json         @default("{}")
  active      Boolean      @default(true)
  media       MediaAsset[]
  tutorials   Tutorial[]
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("services")
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaSource {
  UPLOAD
  IMPORT
}

model MediaAsset {
  id             String        @id @default(uuid()) @db.Uuid
  /// sha256 del archivo: evita duplicados
  sha256         String        @unique
  kind           MediaKind
  mime           String
  sizeBytes      Int           @map("size_bytes")
  storageKey     String        @unique @map("storage_key")
  originalName   String?       @map("original_name")
  title          String        @default("")
  description    String        @default("")
  tags           String[]
  isTutorial     Boolean       @default(false) @map("is_tutorial")
  active         Boolean       @default(true)
  source         MediaSource   @default(UPLOAD)
  productId      String?       @map("product_id") @db.Uuid
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId     String?       @map("category_id") @db.Uuid
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  service        EventService?
  serviceInfo    ServiceInfo?  @relation(fields: [service], references: [service], onDelete: SetNull)
  importedChatId String?       @map("imported_chat_id") @db.Uuid
  importedChat   ImportedChat? @relation(fields: [importedChatId], references: [id], onDelete: SetNull)
  searchText     String        @default("") @map("search_text")
  tutorials      Tutorial[]
  messages       Message[]
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([active, kind])
  @@map("media_assets")
}

model Tutorial {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  content     String        @default("")
  productId   String?       @map("product_id") @db.Uuid
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId  String?       @map("category_id") @db.Uuid
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  service     EventService?
  serviceInfo ServiceInfo?  @relation(fields: [service], references: [service], onDelete: SetNull)
  media       MediaAsset[]
  active      Boolean       @default(true)
  searchText  String        @default("") @map("search_text")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("tutorials")
}

enum ImportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model ImportedChat {
  id           String            @id @default(uuid()) @db.Uuid
  fileName     String            @map("file_name")
  /// sha256 del archivo de texto: el mismo export no se importa dos veces
  sha256       String            @unique
  ownerName    String            @map("owner_name")
  participants String[]
  messageCount Int               @default(0) @map("message_count")
  mediaCount   Int               @default(0) @map("media_count")
  /// La dueña confirmó que puede usar este chat para aprender
  consent      Boolean           @default(false)
  /// Permite reutilizar los medios del chat en la biblioteca
  mediaConsent Boolean           @default(false) @map("media_consent")
  status       ImportStatus      @default(PENDING)
  error        String?
  importedById String?           @map("imported_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")
  processedAt  DateTime?         @map("processed_at")
  messages     ImportedMessage[]
  sources      KnowledgeSource[]
  chunks       KnowledgeChunk[]
  media        MediaAsset[]

  @@map("imported_chats")
}

model ImportedMessage {
  id        String       @id @default(uuid()) @db.Uuid
  chatId    String       @map("chat_id") @db.Uuid
  chat      ImportedChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  position  Int
  sentAt    DateTime     @map("sent_at")
  /// Alias del participante ("Dueña" o "Cliente 1"): no se guardan nombres ni teléfonos
  author    String
  fromOwner Boolean      @map("from_owner")
  /// Texto anonimizado
  text      String
  mediaFile String?      @map("media_file")
  /// hash(fecha + autor + texto): evita duplicados entre exports solapados
  dedupeKey String       @unique @map("dedupe_key")

  @@index([chatId, position])
  @@map("imported_messages")
}

enum KnowledgeKind {
  STYLE
  FAQ
  PRODUCT
  SERVICE
  POLICY
  OBJECTION
  SALES_PROCESS
  OTHER
}

enum KnowledgeStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
  CONFLICT
}

model KnowledgeDocument {
  id             String              @id @default(uuid()) @db.Uuid
  kind           KnowledgeKind
  title          String
  content        String
  status         KnowledgeStatus     @default(PENDING)
  /// 0..1 según qué tan repetido y claro aparece en los chats
  confidence     Float               @default(0.5)
  /// Dato que puede vencer (precios, promos, fechas)
  temporal       Boolean             @default(false)
  version        Int                 @default(1)
  conflictWithId String?             @map("conflict_with_id") @db.Uuid
  conflictWith   KnowledgeDocument?  @relation("KnowledgeConflict", fields: [conflictWithId], references: [id], onDelete: SetNull)
  conflicts      KnowledgeDocument[] @relation("KnowledgeConflict")
  conflictNote   String?             @map("conflict_note")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  sources        KnowledgeSource[]
  chunks         KnowledgeChunk[]
  reviews        KnowledgeReview[]

  @@index([status, kind])
  @@map("knowledge_documents")
}

model KnowledgeSource {
  id         String            @id @default(uuid()) @db.Uuid
  documentId String            @map("document_id") @db.Uuid
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chatId     String?           @map("chat_id") @db.Uuid
  chat       ImportedChat?     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  excerpt    String            @default("")
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([documentId])
  @@map("knowledge_sources")
}

enum ChunkKind {
  DOCUMENT
  EXAMPLE
}

model KnowledgeChunk {
  id         String                       @id @default(uuid()) @db.Uuid
  kind       ChunkKind
  documentId String?                      @map("document_id") @db.Uuid
  document   KnowledgeDocument?           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chatId     String?                      @map("chat_id") @db.Uuid
  chat       ImportedChat?                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  /// Texto recuperable (conocimiento o intercambio cliente → dueña anonimizado)
  text       String
  embedding  Unsupported("vector(1536)")?
  active     Boolean                      @default(true)
  createdAt  DateTime                     @default(now()) @map("created_at")

  @@index([kind, active])
  @@map("knowledge_chunks")
}

model KnowledgeReview {
  id         String            @id @default(uuid()) @db.Uuid
  documentId String            @map("document_id") @db.Uuid
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  action     String
  userId     String?           @map("user_id") @db.Uuid
  note       String?
  before     Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([documentId])
  @@map("knowledge_reviews")
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Cola simple en Postgres para procesos largos (extracción de conocimiento, embeddings)
model Job {
  id        String    @id @default(uuid()) @db.Uuid
  type      String
  payload   Json      @default("{}")
  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  error     String?
  runAt     DateTime  @default(now()) @map("run_at")
  startedAt DateTime? @map("started_at")
  doneAt    DateTime? @map("done_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([status, runAt])
  @@map("jobs")
}
